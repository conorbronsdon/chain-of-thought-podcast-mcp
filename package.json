{
  "name": "chain-of-thought-podcast-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only remote MCP server for searching and citing the Chain of Thought podcast archive (chainofthought.show).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --configLoader runner --pool threads",
    "test:integration": "vitest run -c vitest.integration.config.ts --configLoader runner --pool threads",
    "build-sql": "node scripts/build-sql.ts",
    "build-sql:fixture": "node scripts/build-sql.ts --only 77,38,2 --out dist/fixture.sql",
    "query": "node scripts/query.ts",
    "eval": "node scripts/eval-search.ts",
    "bench": "node scripts/bench-handler.ts",
    "dev:fixture": "wrangler dev --local --persist-to .wrangler/fixture --port 8787",
    "db:fixture": "wrangler d1 execute cot-archive --local --persist-to .wrangler/fixture --file dist/fixture.sql --yes",
    "dev:full": "wrangler dev --local --persist-to .wrangler/full --port 8787",
    "db:full": "wrangler d1 execute cot-archive --local --persist-to .wrangler/full --file dist/ingest.sql --yes"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  }
}
